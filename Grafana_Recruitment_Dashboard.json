          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH total_issues AS (\n    SELECT\n        COUNT(*) AS total\n    FROM\n        jira_issues \n    WHERE\n        issue_type = 'VACANCY'\n),\nfilled_issues AS (\n    SELECT\n        COUNT(*) AS filled\n    FROM\n        jira_issues \n    WHERE\n        current_status = 'CLOSED___VERVULD'\n        AND \n        issue_type = 'VACANCY'\n)\n\nSELECT\n    'Filled Issues' AS label,\n    round(filled::NUMERIC / total * 100) AS percentage\nFROM\n    filled_issues, total_issues;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
