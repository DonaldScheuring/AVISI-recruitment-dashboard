        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ae7abb0e-24a9-494d-ba23-126aecc6fdc8"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH total_applicants AS (\n  SELECT\n    COUNT(*) AS total\n  FROM\n    jira_issues\n  WHERE\n    issue_type = 'APPLICANT'\n),\nreached_beoordeling AS (\n  SELECT\n    COUNT(*) AS applicants_in_beoordeling\n  FROM\n    jira_issues\n  WHERE\n    issue_type = 'APPLICANT'\n    AND NOT (current_status = 'OPEN')\n),\nreached_eerste_gesprek AS (\n  SELECT\n    COUNT(*) AS applicants_in_eerste\n  FROM\n    jira_issues\n  WHERE\n    issue_type = 'APPLICANT'\n    AND NOT current_status = 'OPEN'\n    AND NOT current_status = 'BEOORDELING'\n    AND NOT current_status = 'CLOSED___NIET_OP_GESPREK'\n),\nreached_tweede_gesprek AS (\n  SELECT\n    COUNT(*) AS applicants_in_tweede\n  FROM\n    jira_issues\n  WHERE\n    issue_type = 'APPLICANT'\n    AND NOT current_status = 'OPEN'\n    AND NOT current_status = 'BEOORDELING'\n    AND NOT current_status = 'CLOSED___NIET_OP_GESPREK'\n    AND NOT current_status = 'EERSTE_GESPREK'\n    AND NOT current_status = 'CLOSED___NA_EERSTE_GESPREK'\n),\nreached_derde_gesprek AS (\n  SELECT\n    COUNT(*) AS applicants_in_derde\n  FROM\n    jira_issues\n  WHERE\n    issue_type = 'APPLICANT'\n    AND NOT current_status = 'OPEN'\n    AND NOT current_status = 'BEOORDELING'\n    AND NOT current_status = 'CLOSED___NIET_OP_GESPREK'\n    AND NOT current_status = 'EERSTE_GESPREK'\n    AND NOT current_status = 'CLOSED___NA_EERSTE_GESPREK'\n    AND NOT current_status = 'TWEEDE_GESPREK'\n    AND NOT current_status = 'CLOSED___NA_TWEEDE_GESPREK'\n)\nSELECT\n  (applicants_in_beoordeling :: NUMERIC / total * 100) AS \"percentage op beoordeling\",\n  (applicants_in_eerste :: NUMERIC / total * 100) AS \"percentage op eerste gesprek\", \n  (applicants_in_tweede :: NUMERIC / total * 100) AS \"percentage op tweede gesprek\",\n  (applicants_in_derde :: NUMERIC / total * 100) AS \"percentage op derde gesprek\"\n\nFROM\n  total_applicants,\n  reached_beoordeling,\n  reached_eerste_gesprek,\n  reached_tweede_gesprek,\n  reached_derde_gesprek;",
          "refId": "A",
