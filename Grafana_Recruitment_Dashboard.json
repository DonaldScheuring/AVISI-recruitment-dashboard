            "type": "grafana-postgresql-datasource",
            "uid": "c9702c9e-309a-42f2-aa94-a268acafa5aa"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH VAC_OPEN AS (\r\n Select count(*) as nr_vac_open\r\n from jira_issues \r\n WHERE issue_type = 'VACANCY'\r\n AND current_status = 'VAC_OPEN'\r\n),\r\nKDD_IN_PROCEDURE AS (\r\n Select count(*) as nr_kdd_in_procedure\r\n from jira_issues \r\n WHERE issue_type = 'VACANCY'\r\n AND current_status = 'KDD_IN_PROCEDURE'\r\n),\r\n GEEN_KDD_IN_PROCEDURE AS (\r\n Select count(*) as nr_geen_kdd_in_procedure\r\n from jira_issues \r\n WHERE issue_type = 'VACANCY'\r\n AND current_status = 'GEEN_KDD_IN_PROCEDURE'\r\n),\r\nCLOSED___NIET_VERVULD AS (\r\n Select count(*) as closed_niet_vervuld\r\n from jira_issues \r\n WHERE issue_type = 'VACANCY'\r\n AND current_status = 'CLOSED___NIET_VERVULD'\r\n ),\r\n CLOSED___VERVULD AS (\r\n Select count(*) as closed_vervuld\r\n from jira_issues \r\n WHERE issue_type = 'VACANCY'\r\n AND current_status = 'CLOSED___VERVULD')\r\nSELECT\r\nnr_vac_open as \"vacancies open\",\r\nnr_kdd_in_procedure as \"vacancies kdd in procedure\",\r\nnr_geen_kdd_in_procedure as \"vacancies geen kdd in procedure\",\r\nclosed_niet_vervuld as \"vacancies closed (niet vervuld)\",\r\nclosed_vervuld as \"vacancies closed (vervuld)\"\r\nFROM\r\nCLOSED___VERVULD,\r\nCLOSED___NIET_VERVULD,\r\nGEEN_KDD_IN_PROCEDURE,\r\nKDD_IN_PROCEDURE,\r\n VAC_OPEN;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Vacancies per status",
      "type": "bargauge"
    },
